{
  "name": "inec-field-officer",
  "version": "2.0.0",
  "description": "INEC 2.0 Field Officer Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace InecFieldOfficer.xcworkspace -scheme InecFieldOfficer -configuration Release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "@react-native-firebase/app": "^19.0.0",
    "@react-native-firebase/auth": "^19.0.0",
    "@react-native-firebase/firestore": "^19.0.0",
    "@react-native-firebase/storage": "^19.0.0",
    "react-native-agora": "^4.3.0",
    "react-native-geolocation-service": "^5.3.1",
    "@react-native-community/netinfo": "^11.2.1",
    "react-native-image-picker": "^7.0.3",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "react-native-screens": "^3.31.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-vector-icons": "^10.0.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react-native-permissions": "^4.1.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.0.4"
  }
}
